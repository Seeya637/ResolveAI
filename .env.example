APP_NAME=ResolveAI Servicing Backend
ENVIRONMENT=development

# Point this at Postgres once docker-compose is up. Until then the app
# falls back to a local SQLite file so you can develop without docker.
DATABASE_URL=postgresql+psycopg2://resolveai:resolveai@localhost:5432/resolveai_db
REDIS_URL=redis://localhost:6379/0

FEE_REVERSAL_MAX_AMOUNT=500.0
FEE_REVERSAL_MIN_ACCOUNT_AGE_MONTHS=6
CREDIT_LIMIT_MAX_AUTO_INCREASE=20000.0
CREDIT_LIMIT_MIN_ACCOUNT_AGE_MONTHS=12

# Required on every servicing request as the X-API-Key header. Rotate
# this and move to per-caller keys before any real deployment.
INTERNAL_API_KEY=change-me-in-production
